PORT=3001

# Google sign-in (Web application OAuth client)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Where the dashboard runs (OAuth returns here after Google)
DASHBOARD_ORIGIN=http://localhost:5174
JWT_SECRET=change-me-in-production
AUTH_REQUIRED=false

# Local extraction mode (default true). Set false to enable OpenAI on /chat.
ECHO_EXTRACTION_ONLY=true

# AI (plug-and-play: openai | stub)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

CONTEXT_TTL_MS=86400000
PRUNE_INTERVAL_MS=300000
